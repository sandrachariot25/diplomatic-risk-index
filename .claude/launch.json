{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dri-streamlit",
      "runtimeExecutable": ".venv\\Scripts\\python.exe",
      "runtimeArgs": ["-m", "streamlit", "run", "app.py", "--server.address", "127.0.0.1", "--server.port", "8502", "--server.headless", "true"],
      "port": 8502
    },
    {
      "name": "dri-site",
      "runtimeExecutable": ".venv\\Scripts\\python.exe",
      "runtimeArgs": ["-m", "http.server", "8510", "--bind", "127.0.0.1", "--directory", "site"],
      "port": 8510
    }
  ]
}
